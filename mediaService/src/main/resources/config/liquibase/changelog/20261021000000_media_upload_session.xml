<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
 <changeSet id="20261021000000" author="codex">
  <createTable tableName="media_upload_session">
   <column name="id" type="varchar(36)"><constraints primaryKey="true" nullable="false"/></column>
   <column name="owner_id" type="varchar(36)"><constraints nullable="false"/></column>
   <column name="public_id" type="varchar(255)"><constraints nullable="false" unique="true"/></column>
   <column name="file_name" type="varchar(255)"><constraints nullable="false"/></column>
   <column name="expires_at" type="${datetimeType}"><constraints nullable="false"/></column>
   <column name="media_id" type="varchar(36)"/>
  </createTable>
  <createIndex tableName="media_upload_session" indexName="idx_upload_session_cleanup">
   <column name="media_id"/><column name="expires_at"/>
  </createIndex>
  <addForeignKeyConstraint baseTableName="media_upload_session" baseColumnNames="media_id"
   referencedTableName="media" referencedColumnNames="id" constraintName="fk_upload_session_media" onDelete="SET NULL"/>
 </changeSet>
</databaseChangeLog>
