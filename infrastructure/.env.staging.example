# =============================================================================
# FAKEBOOK MONOREPO STAGING ENVIRONMENT CONFIGURATION TEMPLATE
# File: infrastructure/.env.staging.example
# Instructions: Copy this file to '.env.staging' on the staging host, replace
#               every replace_me_* value, and keep the resulting file out of Git:
#               cp infrastructure/.env.staging.example infrastructure/.env.staging
# =============================================================================

# 1. STAGING DOMAIN & NETWORK SETUP
DOMAIN_NAME=replace_me_staging_domain
STAGING_DOMAIN=${DOMAIN_NAME}
STAGING_FRONTEND_URL=https://${DOMAIN_NAME}
KEYCLOAK_HOSTNAME=https://${DOMAIN_NAME}

# NGINX REVERSE PROXY & SECURITY
TLS_CERT_NAME=${DOMAIN_NAME}
KEYCLOAK_ADMIN_ALLOWLIST=

# DOCKER REGISTRY & IMAGE TAG
DOCKER_REGISTRY_PREFIX=ghcr.io/minhelly/
IMAGE_TAG=sha-replace_me_full_40_character_git_sha

# 2. EXTERNAL AWS RDS MARIADB & SERVICE-SPECIFIC DATABASE CREDENTIALS
# Use the RDS DNS endpoint, not an IP address. The RDS master credentials are
# intentionally not stored here; use them only to bootstrap databases/users.
MARIADB_HOST=replace_me_rds_endpoint
MARIADB_PORT=3306
MARIADB_SSL_CERT_HOST_PATH=./certs/global-bundle.pem
MARIADB_SSL_CERT_CONTAINER_PATH=/run/secrets/rds-global-bundle.pem

# Keep the total connection budget below the RDS max_connections value.
KEYCLOAK_DB_POOL_INITIAL_SIZE=1
KEYCLOAK_DB_POOL_MIN_SIZE=1
KEYCLOAK_DB_POOL_MAX_SIZE=5
APP_DB_POOL_MIN_IDLE=1
APP_DB_POOL_MAX_SIZE=3
GATEWAY_DB_POOL_INITIAL_SIZE=1
GATEWAY_DB_POOL_MAX_SIZE=3

GATEWAY_DB_USERNAME=gateway_user
GATEWAY_DB_PASSWORD=replace_me_gateway_db_password

AUTH_DB_USERNAME=auth_user
AUTH_DB_PASSWORD=replace_me_auth_db_password

USER_DB_USERNAME=user_user
USER_DB_PASSWORD=replace_me_user_db_password

POST_DB_USERNAME=post_user
POST_DB_PASSWORD=replace_me_post_db_password

MEDIA_DB_USERNAME=media_user
MEDIA_DB_PASSWORD=replace_me_media_db_password

COMMENT_DB_USERNAME=comment_user
COMMENT_DB_PASSWORD=replace_me_comment_db_password

FEED_DB_USERNAME=feed_user
FEED_DB_PASSWORD=replace_me_feed_db_password

KEYCLOAK_DB_USERNAME=keycloak_user
KEYCLOAK_DB_PASSWORD=replace_me_keycloak_db_password

# 3. KEYCLOAK IAM BOOTSTRAP & OIDC CREDENTIALS 
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=replace_me_keycloak_admin_password

FAKEBOOK_OIDC_ISSUER_URI=https://${DOMAIN_NAME}/realms/jhipster
FAKEBOOK_OIDC_GATEWAY_CLIENT_ID=web_app
FAKEBOOK_OIDC_GATEWAY_CLIENT_SECRET=replace_me_gateway_oidc_client_secret
FAKEBOOK_OIDC_INTERNAL_CLIENT_ID=internal
FAKEBOOK_OIDC_INTERNAL_CLIENT_SECRET=replace_me_internal_oidc_client_secret

# Optional Google Identity Provider for Keycloak SSO
KEYCLOAK_GOOGLE_CLIENT_ID=your_google_client_id_here
KEYCLOAK_GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# 4. KEYCLOAK SMTP MAIL SERVER CONFIGURATION
KEYCLOAK_SMTP_HOST=localhost
KEYCLOAK_SMTP_PORT=1025
KEYCLOAK_SMTP_FROM=no-reply@fakebook.com
KEYCLOAK_SMTP_AUTH=false
KEYCLOAK_SMTP_USER=
KEYCLOAK_SMTP_PASSWORD=

# 5. CLOUDINARY MEDIA SERVICE CREDENTIALS
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 6. INFRASTRUCTURE PORTS (USED INTERNALLY OR VIA PROXY)
KEYCLOAK_HTTP_PORT=9080
CONSUL_HTTP_PORT=8500
SPRING_CLOUD_CONSUL_HOST=consul
SPRING_CLOUD_CONSUL_PORT=8500
KAFKA_PORT=29092
REDIS_PORT=6379
ZIPKIN_PORT=9411
