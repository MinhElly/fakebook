# Example only. Select and configure the actual provider before deployment.
apiVersion: external-secrets.io/v1
kind: SecretStore
metadata:
  name: fakebook-staging
  namespace: fakebook-staging
spec:
  provider:
    vault:
      server: https://vault.staging.example.invalid
      path: secret
      version: v2
      auth:
        kubernetes:
          mountPath: kubernetes
          role: fakebook-staging
          serviceAccountRef:
            name: external-secrets
