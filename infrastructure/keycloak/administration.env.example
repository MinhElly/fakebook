# Backend-only confidential realm-management client (userService).
FAKEBOOK_ADMIN_CLIENT_ID=fakebook-administration
FAKEBOOK_ADMIN_CLIENT_SECRET=
# Existing M2M client, configured on Gateway and every service.
FAKEBOOK_OIDC_INTERNAL_CLIENT_ID=internal
FAKEBOOK_OIDC_INTERNAL_CLIENT_SECRET=
# Configure according to the environment; these examples are service-network URLs.
USER_SERVICE_URL=http://userservice:8082
POST_SERVICE_URL=http://postservice:8083
MEDIA_SERVICE_URL=http://mediaservice:8084
COMMENT_SERVICE_URL=http://commentservice:8085
