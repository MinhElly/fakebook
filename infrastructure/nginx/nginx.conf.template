events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    # Cấu hình log format
    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /var/log/nginx/access.log main;
    error_log  /var/log/nginx/error.log warn;

    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    keepalive_timeout 65;

    # Gzip nén dữ liệu cho trang web chạy nhanh
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    # DNS Resolver nội bộ trong Docker Network
    resolver 127.0.0.11 valid=30s;

    # =========================================================================
    # 1. HTTP Server Block: Tự động Redirect HTTP sang HTTPS & Xác thực Certbot
    # =========================================================================
    server {
        listen 80;
        server_name ${PUBLIC_DOMAIN};

        # Chỗ cho Certbot kiểm tra xác thực tên miền khi cấp SSL
        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        # Redirect toàn bộ truy cập HTTP thường sang HTTPS
        location / {
            return 301 https://$host$request_uri;
        }
    }

    # =========================================================================
    # 2. HTTPS Server Block: Reverse Proxy cho Single Domain
    # =========================================================================
    server {
        listen 443 ssl;
        server_name ${PUBLIC_DOMAIN};

        # Cấu hình đường dẫn chứng chỉ SSL Let's Encrypt Certbot trên VPS
        ssl_certificate     /etc/letsencrypt/live/${TLS_CERT_NAME}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/${TLS_CERT_NAME}/privkey.pem;

        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers HIGH:!aNULL:!MD5;
        ssl_prefer_server_ciphers on;

        # Giới hạn kích thước upload (Ảnh/Video Media)
        client_max_body_size 50M;

        # Các Proxy Headers bắt buộc để Keycloak & Spring Boot Gateway nhận diện SSL
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;

        # ---------------------------------------------------------------------
        # ROUTE 1: Chuyển hướng tới Keycloak IAM (/realms, /resources)
        # ---------------------------------------------------------------------
        location /realms/ {
            proxy_pass http://fakebook-keycloak:9080/realms/;
            proxy_buffer_size 128k;
            proxy_buffers 4 256k;
            proxy_busy_buffers_size 256k;
        }

        location /resources/ {
            proxy_pass http://fakebook-keycloak:9080/resources/;
        }

        # ---------------------------------------------------------------------
        # ROUTE 1.1: Keycloak Admin Console (Bảo vệ: IP Allowlist / VPN / SSH Tunnel)
        # Không mở public ra Internet; chỉ cho phép Localhost (SSH Tunnel), VPN, IP nội bộ
        # ---------------------------------------------------------------------
        location /admin/ {
            # 1. Localhost (cho SSH Tunnel: ssh -L 8443:localhost:443 hoặc Dynamic SOCKS5)
            allow 127.0.0.1;
            allow ::1;

            # 2. Mạng nội bộ & VPN (RFC 1918 & Tailscale)
            allow 10.0.0.0/8;
            allow 172.16.0.0/12;
            allow 192.168.0.0/16;
            allow 100.64.0.0/10;

            # 3. IP tĩnh admin bổ sung (tùy chọn qua biến môi trường KEYCLOAK_ADMIN_ALLOWLIST)
            ${KEYCLOAK_ADMIN_ALLOWLIST}

            # 4. Chặn toàn bộ IP công cộng còn lại
            deny all;

            proxy_pass http://fakebook-keycloak:9080/admin/;
            proxy_buffer_size 128k;
            proxy_buffers 4 256k;
            proxy_busy_buffers_size 256k;
        }

        # ---------------------------------------------------------------------
        # ROUTE 2: Chuyển hướng tới Spring Cloud API Gateway (/services/ & /api/)
        # ---------------------------------------------------------------------
        location /services/ {
            proxy_pass http://fakebook-gateway:8080/services/;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port 443;
        }

        location /api/ {
            proxy_pass http://fakebook-gateway:8080/api/;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
        }

        # ---------------------------------------------------------------------
        # ROUTE 3: Single Page Application / Frontend Root (/)
        # ---------------------------------------------------------------------
        location / {
            return 302 ${FRONTEND_URL}$request_uri;
        }
    }
}
