<?xml version="1.0" encoding="utf-8"?>
    <databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

        <changeSet id="20260911000000-1" author="jhipster">
            <createTable tableName="post_tagged_users">
                <column name="post_id" type="varchar(36)">
                    <constraints nullable="false"/>
                </column>
                <column name="user_id" type="varchar(36)">
                    <constraints nullable="false"/>
                </column>
            </createTable>
            <addPrimaryKey tableName="post_tagged_users" columnNames="post_id, user_id"
  constraintName="pk_post_tagged_users"/>
            <addForeignKeyConstraint baseColumnNames="post_id" baseTableName="post_tagged_users"
                                     constraintName="fk_post_tagged_users_post_id"
                                     referencedColumnNames="id" referencedTableName="posts"/>
        </changeSet>
    </databaseChangeLog>